{
    "compilerOptions": {
        "rootDir": "./src/",
        "outDir": "./dist/",
        "noImplicitAny": true,
        "sourceMap": true,
        "module": "ES2020",
        "moduleResolution": "bundler",
        "target": "ES2020",
        "allowJs": true
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules"]
}

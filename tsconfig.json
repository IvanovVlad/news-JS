{
    "compilerOptions": {
        "rootDir": "./src/",
        "outDir": "./dist/",
        "noImplicitAny": true,
        "strict": true,
        "sourceMap": true,
        "module": "ES2020",
        "moduleResolution": "bundler",
        "target": "ES2020",
        "allowJs": true
    },
    "ts-node": {
        "compilerOptions": {
            "module": "nodenext",
            "moduleResolution": "nodenext",
            "rootDir": "."
        }
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules"]
}
